source "https://rubygems.org"

# GitHub Pages builds this site with its own pinned gem set; this Gemfile
# exists so `bundle exec jekyll serve` matches that locally.
gem "github-pages", group: :jekyll_plugins

group :jekyll_plugins do
  gem "jekyll-seo-tag"
  gem "jekyll-redirect-from"
  gem "jekyll-sitemap"
end
